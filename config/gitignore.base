# === appkit base (managed) ===
# Copied verbatim into each app repo's .gitignore between these markers and
# verified by `kit doctor`. Git refuses to follow a symlinked .gitignore — it
# fails with "Too many levels of symbolic links" and then silently applies no
# rules at all — so this one file is copied rather than linked. Repo-specific
# rules go BELOW the closing marker, where the kit will not touch them.

# macOS
.DS_Store

# Build products — Xcode, Gradle, Node
build/
.build/
DerivedData/
Packages/
*.xcuserstate
**/xcuserdata/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.gradle/
local.properties
node_modules/
.next/

# Raw device captures are pipeline intermediates, regenerated by `kit capture`.
# What ships is composed from these into store/screenshots/, which IS tracked —
# a store screenshot is reviewed in a diff, and `git status` after a run is the
# answer to "did any screen change".
.screenshots/

# Store API scratch: what a publisher staged, and what it pulled down to
# compare. Both are materialised from the tracked copy at push time.
.asc/
.play/

# Credentials. The App Store Connect key belongs in the login keychain
# (`asc auth login`), never in a working tree; the Play service-account key has
# no keychain equivalent and lives here, ignored.
.netrc
.secrets/

# Local secrets injected as build settings. NEVER commit — a real key was once
# committed in one of these repos and had to be rotated.
Secrets.xcconfig
**/Secrets.xcconfig
# === end appkit base ===
